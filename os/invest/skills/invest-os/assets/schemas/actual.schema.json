{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invest OS actual",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "invest.actual-trade.v1"
    },
    "trade_id": {
      "type": "string",
      "minLength": 1
    },
    "account_alias": {
      "type": "string",
      "minLength": 1
    },
    "security": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "share_class": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "product_type": {
          "enum": [
            "stock",
            "etf",
            "otc_fund",
            "qdii",
            "bond_fund",
            "cash_management"
          ]
        }
      },
      "required": [
        "name",
        "code",
        "venue",
        "share_class",
        "product_type"
      ],
      "additionalProperties": false
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ]
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fees_cny": {
      "type": "number",
      "minimum": 0
    },
    "cash_delta_cny": {
      "type": "number"
    },
    "currency": {
      "const": "CNY"
    },
    "status": {
      "const": "filled"
    },
    "confirmed_by_user": {
      "const": true
    },
    "source": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source_ref",
        "source_as_of",
        "retrieved_at"
      ],
      "additionalProperties": false
    },
    "motive": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "emotion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "user_statement_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "ai_signal_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "ai_alignment": {
      "enum": [
        "aligned",
        "deviated",
        "no_signal",
        "unknown"
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "trade_id",
    "account_alias",
    "security",
    "executed_at",
    "side",
    "price",
    "quantity",
    "fees_cny",
    "cash_delta_cny",
    "currency",
    "status",
    "confirmed_by_user",
    "source",
    "motive",
    "emotion",
    "user_statement_ref",
    "ai_signal_id",
    "ai_alignment",
    "supersedes"
  ],
  "additionalProperties": false
}
