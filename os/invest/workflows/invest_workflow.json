        "holdings",
        "market",
        "quant",
        "reconciliation",
        "diagnosis",
        "risk",
        "goals",
        "behavior",
        "evaluation",
        "opportunities",
        "trade_plan"
      ],
      "provider_skills": [],
      "objective": "汇总唯一主简报与缺口，不重新启动总流程",
      "execution": "agent_skill"
    }
